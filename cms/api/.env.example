# Copy to .env (git-ignored). Everything is optional for local development:
# with no DATABASE_URL the API uses an embedded PostgreSQL (PGlite) in cms/api/data/.

# PostgreSQL / Supabase. Supabase dashboard → Connect. Locally the direct URI (port 5432) works;
# on Vercel use the Transaction pooler URI (port 6543). REQUIRED on Vercel.
DATABASE_URL=

# Supabase Storage for profile photos, location and article images (Project Settings → API). Server-side only.
# Empty = files go to cms/api/uploads (local development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=site-media
SUPABASE_PRIVATE_BUCKET=private-files

# One-time key for creating the first CMS administrator on the setup screen (required on Vercel).
ADMIN_SETUP_KEY=

# Outgoing email through Gmail (Google Account → Security → 2-Step Verification → App passwords).
# Empty = emails are skipped and logged; in development, account links are shown on screen instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Aurelia Concierge
# Public website address, used for links in emails (booking status, account) and the sitemap
SITE_URL=http://localhost:5173

PORT=4000
# Set SEED_DEMO=0 to start with an empty database instead of demo data
SEED_DEMO=1

# Encryption key for booking chats, timeline messages and client notes (AES-256-GCM). REQUIRED on Vercel and
# with a hosted DATABASE_URL; use the SAME value locally and in Vercel. Keep a copy safe: losing it loses the messages.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=
# After changing the key: previous key(s) here (comma separated), then run `npm run db:encrypt-messages`.
MESSAGE_ENCRYPTION_KEYS_OLD=

# ---------- Security (all optional) ----------
# Behind your own proxy / load balancer (not Vercel): how many proxies add X-Forwarded-For, so rate limits
# see the real client IP. Leave empty when the API is reached directly.
TRUST_PROXY=
# Other sites allowed to call the API with cookies (exact origins, comma separated). The website and CMS
# call it on their own domain and don't need this.
CORS_ORIGIN=
# Per-IP request ceiling per minute (sign-in and forms have their own, lower limits).
RATE_LIMIT_READS=300
RATE_LIMIT_WRITES=60
